// NorthStar Fortune Insights — Prisma schema
//
// Phase 0 scope: only enough of the model to prove the migrate/generate/seed
// workflow end to end. The full data model (spec section 10) lands with the
// phase that owns each entity. `User` here is a deliberate placeholder — Phase 2
// extends it to the Auth.js adapter shape and adds Account/Session/VerificationToken.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(USER)
  locale    String   @default("en-CA")
  timezone  String   @default("America/Toronto")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("users")
}
