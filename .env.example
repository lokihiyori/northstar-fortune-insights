# Copy to `.env` and fill in locally. Never commit a populated `.env`.
# Names only — this file must never contain real secrets.

# --- Phase 0: local infrastructure ---
# Host ports the Docker services publish on. These are read by `pnpm db:up`
# (compose is invoked with --env-file .env) and must agree with the URLs below.
#
# They default to non-standard values on purpose. If you already run PostgreSQL
# or Redis locally, a native service on 5432 will shadow Docker's published port
# on IPv4 and silently answer connections meant for the container — which
# surfaces as a confusing "authentication failed" from Prisma. Using 55432/56379
# keeps the two side by side. Set them to 5432/6379 if you have no local server.
POSTGRES_PORT=55432
REDIS_PORT=56379

# Use 127.0.0.1 rather than localhost so the driver cannot pick IPv6 first.
DATABASE_URL="postgresql://northstar:northstar@127.0.0.1:55432/northstar?schema=public"
# Direct (non-pooled) connection, used by migrations against a pooled host.
DIRECT_DATABASE_URL=
REDIS_URL="redis://127.0.0.1:56379"

# Set to "true" to create a local admin account during `pnpm db:seed`.
SEED_ADMIN=

# --- Phase 2: authentication ---
# Required. Generate with: npx auth secret
AUTH_SECRET=
# Optional locally — the Google button is hidden when these are unset.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Phase 4: guidance engine ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# --- Phase 6: billing and analytics ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Phase 8B: rate limiting ---
# How many trusted reverse proxies sit in front of the app.
#
# Leave unset (or 0) unless you actually run one. At 0, X-Forwarded-For is
# ignored entirely, which is the safe default: the header is client input, and
# believing it would let an attacker invent a new address per request. The cost
# is that per-IP limits are skipped — the per-user and per-account limits still
# apply. Set this to the real hop count once a deployment proxy is chosen.
RATE_LIMIT_TRUSTED_PROXY_HOPS=

# --- Public ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
