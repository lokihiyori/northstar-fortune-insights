# Copy to `.env` and fill in locally. Never commit a populated `.env`.
# Names only — this file must never contain real secrets.

# --- Phase 0: local infrastructure ---
# Matches the defaults in docker/docker-compose.yml.
DATABASE_URL="postgresql://northstar:northstar@localhost:5432/northstar?schema=public"
# Direct (non-pooled) connection, used by migrations against a pooled host.
DIRECT_DATABASE_URL=
REDIS_URL="redis://localhost:6379"

# Set to "true" to create a local admin account during `pnpm db:seed`.
SEED_ADMIN=

# --- Phase 2: authentication ---
# Required. Generate with: npx auth secret
AUTH_SECRET=
# Optional locally — the Google button is hidden when these are unset.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Phase 4: guidance engine ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# --- Phase 6: billing and analytics ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Public ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
